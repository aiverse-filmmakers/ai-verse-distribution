# Distribution release metadata and companion locks are cryptographic artifacts.
# Keep their checked-out bytes identical to Git blob bytes on every platform.
dependency-locks/** text eol=lf
src/aiverse_distribution/dependency_locks/** text eol=lf
qualification/repaired-core/dependency_locks/** text eol=lf
qualification/core-stable-2026-10-10/dependency_locks/** text eol=lf
src/aiverse_distribution/catalog/*.json text eol=lf
release-sets/*.json text eol=lf
profiles/*.json text eol=lf
compatibility/*.json text eol=lf
# Candidate evidence contains byte-bound snapshots; keep checkout bytes stable on every platform.
qualification/**/candidate-evidence.json text eol=lf
