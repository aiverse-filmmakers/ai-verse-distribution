  "whats_new": [
    {
      "title": "Move or copy your OS safely",
      "detail": "Ask your assistant if your OS is ready to move. After a move or rename it repairs itself, and a copy never touches the original."
    },
    {
      "title": "My skills live inside your OS",
      "detail": "Skills you make are kept in my-skills inside your OS folder, so they travel with it, and chats list them as My skills."
    },
    {
      "title": "See which skills you use",
      "detail": "Each skill now counts how often it was used and when."
    },
    {
      "title": "Skill packs and red-team",
      "detail": "Add a skill pack in one step, and red-team is a small new skill that stress tests a plan or idea."
    },
    {
      "title": "Fewer interruptions",
      "detail": "Tidying no longer asks you about old notes in the middle of a chat about something else."
    },
    {
      "title": "Optional meaning search",
      "detail": "Memory can now find notes by meaning, not just words, when you turn it on."
    }
  ],
