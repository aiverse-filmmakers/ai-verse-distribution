  "whats_new": [
    {
      "title": "Keep chats with your OS",
      "detail": "You can turn on private chat saving in supported local Claude Code and Codex versions on Mac and Linux. Saved conversations remain in your OS folder when you move it or switch supported tools."
    },
    {
      "title": "Find original conversations",
      "detail": "Ask in your own words, open the original saved message, and keep looking through older chats."
    },
    {
      "title": "Put chats in the right project",
      "detail": "Review and approve a move between Personal and a project. Earlier message links keep working, and AI-Verse stops returning the chat from its old project."
    },
    {
      "title": "Review more of what AI-Verse remembers",
      "detail": "AI-Verse can review older saved notes, notice lasting rules, and improve the words used to find memories later."
    },
    {
      "title": "Safer handling of outside instructions",
      "detail": "Extra checks help stop instructions inside outside material and skills from being treated as your own requests."
    },
    {
      "title": "Updates include existing helpers",
      "detail": "A normal update also refreshes helpers you already use, preserves their settings and leaves local edits alone. AI-Verse explains when another step is needed."
    }
  ],
