{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiverse.local/contracts/component-release-descriptor.schema.json",
  "title": "AI-Verse Component Release Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "component_id",
    "version",
    "revision",
    "release_status",
    "package",
    "supported_platforms",
    "runtime_requirements",
    "lifecycle",
    "state",
    "migration",
    "authority",
    "evidence",
    "semantics"
  ],
  "properties": {
    "schema_version": { "const": "ai-verse.component-release/v1" },
    "component_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "minLength": 2,
      "maxLength": 80
    },
    "version": { "type": "string", "minLength": 1, "maxLength": 80 },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$",
      "description": "Exact immutable Git revision. Floating refs are forbidden."
    },
    "release_status": { "enum": ["candidate", "accepted"] },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_type"],
      "properties": {
        "repository": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "source_type": { "enum": ["git", "npm", "pypi", "archive"] },
        "package_name": { "type": ["string", "null"] },
        "integrity": { "type": ["string", "null"] }
      }
    },
    "supported_platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["linux", "macos", "windows"] }
    },
    "runtime_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "python": { "type": ["string", "null"] },
        "node": { "type": ["string", "null"] },
        "other": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "required": ["python", "node", "other"]
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["install", "setup", "status", "doctor", "enable", "disable", "update", "uninstall"],
      "properties": {
        "install": { "type": "boolean" },
        "setup": { "type": "boolean" },
        "status": { "type": "boolean" },
        "doctor": { "type": "boolean" },
        "enable": { "type": "boolean" },
        "disable": { "type": "boolean" },
        "update": { "type": "boolean" },
        "uninstall": { "type": "boolean" }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_state_owned",
        "preserve_on_update",
        "preserve_on_uninstall",
        "preserve_unknown_user_files"
      ],
      "properties": {
        "canonical_state_owned": { "type": "boolean" },
        "preserve_on_update": { "const": true },
        "preserve_on_uninstall": { "const": true },
        "preserve_unknown_user_files": { "const": true },
        "state_format": { "type": ["string", "null"] }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility",
        "from_versions",
        "requires_explicit_migration",
        "owner_controlled",
        "checkpoint_policy"
      ],
      "properties": {
        "compatibility": { "enum": ["none-required", "compatible", "explicit-migration", "blocked"] },
        "from_versions": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "requires_explicit_migration": { "type": "boolean" },
        "owner_controlled": { "const": true },
        "checkpoint_policy": {
          "enum": ["not-required", "owner-evidence-required", "unsupported"]
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grants_permissions",
        "changes_direction_owner",
        "changes_scope",
        "enables_disabled_component",
        "exposes_remote_listener"
      ],
      "properties": {
        "grants_permissions": { "const": false },
        "changes_direction_owner": { "const": false },
        "changes_scope": { "const": false },
        "enables_disabled_component": { "const": false },
        "exposes_remote_listener": { "const": false }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ci", "acceptance"],
      "properties": {
        "ci": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_item" }
        },
        "acceptance": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/evidence_item" }
        }
      }
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release_metadata_only", "live_health_truth"],
      "properties": {
        "release_metadata_only": { "const": true },
        "live_health_truth": { "const": false }
      }
    }
  },
  "$defs": {
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "status", "revision"],
      "properties": {
        "kind": { "type": "string", "minLength": 1, "maxLength": 80 },
        "status": { "const": "pass" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "run_id": { "type": ["string", "integer", "null"] },
        "url": { "type": ["string", "null"] }
      }
    }
  }
}
